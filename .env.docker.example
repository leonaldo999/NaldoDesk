APP_NAME=NaldoDesk
APP_ENV=local
APP_KEY=base64:replace_with_a_random_32_byte_key
APP_DEBUG=true
APP_URL=http://localhost:8080
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=naldo_desk
DB_USERNAME=naldo_app
DB_PASSWORD=replace_with_a_local_password
POSTGRES_DB=naldo_desk
POSTGRES_USER=naldo_app
POSTGRES_PASSWORD=replace_with_the_same_local_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

REALTIME_ENABLED=true
REALTIME_EVENT_CHANNEL=naldo:events
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
SESSION_REVALIDATION_INTERVAL_MS=60000
